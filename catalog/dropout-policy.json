{
  "schema_version": 1,
  "policy_id": "online-idle-removal-001",
  "status": "specification_not_implemented",
  "core_status": "confirmed_by_designer_2026-11-15",
  "confirmed_core": {
    "idle_timeout_seconds": 300,
    "automatic_kick": false,
    "approval": "strict_majority_of_other_active_players",
    "target_votes": false,
    "host_override": false,
    "skip_all_future_turns": true,
    "sole_non_removed_player_wins": true,
    "connection_count_alone_determines_winner": false
  },
  "majority_rule": {
    "formula": "floor(eligible_other_players / 2) + 1",
    "ties_fail": true,
    "zero_voters_cannot_remove": true,
    "server_revalidates_before_commit": true
  },
  "integration_requirements": {
    "remove_unresolved_action_tokens_from_stacks": true,
    "preserve_completed_actions": true,
    "exclude_forfeited_players_from_future_input_waits": true,
    "forfeit_skips_trigger_insurance": false,
    "reject_stale_commands": true,
    "no_stranger_takes_seat": true,
    "preserve_initial_board_mode_event_deck_and_round_setup": true,
    "apply_at_safe_checkpoint": true,
    "audit_removal_and_result_reason": true
  },
  "proposed_details": {
    "P01": {
      "status": "designer_review_required",
      "clock_triggers": [
        "continuous_disconnect",
        "required_decision_without_response"
      ],
      "watching_other_players_is_idle": false,
      "warning_after_seconds": 240,
      "authenticated_ack_or_response_cancels_vote": true,
      "successful_reconnect_before_removal_cancels_vote": true,
      "agreed_pause_freezes_clock": true,
      "electorate": "other_non_removed_players_not_themselves_idle_eligible",
      "disconnected_within_grace_still_counts_in_electorate": true
    },
    "P02": {
      "status": "designer_review_required",
      "keep_existing_ships_settlements_techs_and_recorded_resources": true,
      "applicable_passive_tech_effects_continue": true,
      "removed_players_can_win": false
    },
    "P03": {
      "status": "designer_review_required",
      "optional_choices": "decline",
      "mandatory_public_choices": "next_non_removed_player_in_existing_player_order",
      "reroll_revealed_outcomes": false
    },
    "P04": {
      "status": "designer_review_required",
      "unrevealed_bid": "cancel_without_revealing_and_release_reservation",
      "revealed_resolved_bid_and_payment": "preserve",
      "removed_event_selector": "use_P03"
    },
    "P05": {
      "status": "designer_review_required",
      "last_player_finish_reason": "last_player_remaining",
      "score_basis": "position_points_snapshot_at_forfeit_end",
      "normal_endgame_scoring_completed": false,
      "position_points_determine_forfeit_winner": false
    }
  },
  "no_remaining_players_result": "abandoned_no_winner",
  "designer_review_reference": "../docs/DROPOUTS.md"
}
