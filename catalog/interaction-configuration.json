    "selected_system_explore_count": true,
    "explore_outcomes_visible": true,
    "economy_first_player_token_stages": true,
    "reinforcement_controls_on_board": true
  },
  "plan_placement": {
    "desktop": "translucent_cursor_hover_then_click_to_commit",
    "touch": "tap_or_drag_and_release_on_legal_system",
    "invalid_drop_cancels": true
  },
  "camera_control_labels": {
    "fit_board": "Reset View",
    "pan_controls_grouped_with_zoom": true
  }
