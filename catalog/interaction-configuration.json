{
  "schema_version": 3,
  "status": "local_prototype_implemented_remote_controls_pending",
  "view_ids": [
    "board",
    "techs",
    "event",
    "actions",
    "player_aid"
  ],
  "persistent_resource_counts": [
    "reserve",
    "credits"
  ],
  "preserve_on_view_change": [
    "camera",
    "selection",
    "scroll_position",
    "valid_draft",
    "focus_context"
  ],
  "navigation_commits_game_actions": false,
  "phone_proposed_defaults": {
    "board_pinch": "zoom_about_gesture_focus",
    "background_drag": "pan_camera",
    "navigation_swipe_scope": "dedicated_header_or_handle",
    "required_visible_alternatives": [
      "destination_tabs",
      "zoom_in",
      "zoom_out",
      "fit_board",
      "pan_or_detail_controls"
    ]
  },
  "keyboard_proposed_defaults": {
    "B": "board",
    "T": "techs",
    "E": "event",
    "A": "actions",
    "R": "fit_board",
    "+": "zoom_in",
    "-": "zoom_out",
    "ArrowKeys": "pan_board",
    "Escape": "close_overlay_restore_focus",
    "?": "shortcut_help",
    "P": "player_aid"
  },
  "keyboard_safeguards": {
    "focus_scope": "game_interface",
    "camera_requires_board_focus": true,
    "ignore_editable_fields": true,
    "preserve_browser_modifiers": [
      "Control",
      "Meta",
      "Alt"
    ],
    "character_shortcuts_disableable": true,
    "global_shortcut_commits_game_actions": false
  },
  "exact_bindings_status": "implemented_pending_device_playtest",
  "idle_warning_visible_in_all_views": true,
  "dropout_policy_reference": "dropout-policy.json",
  "view_labels": {
    "board": "Board",
    "techs": "Techs",
    "event": "Event",
    "actions": "Actions and Supply",
    "player_aid": "Player Aid"
  },
  "actions_view_contents": [
    "move_into_slot",
    "settle_slot",
    "produce_slot",
    "attack_slot",
    "reserve_supply",
    "credits_supply"
  ],
  "shared_player_aid": {
    "quantity": 1,
    "side_count": 2,
    "both_sides_rendered_together": true,
    "wide_layout": "side_by_side",
    "narrow_layout": "stacked_same_scroll_view",
    "front_back_toggle_required": false
  },
  "undo_policy_reference": "undo-policy.json",
  "tutorial_configuration_reference": "tutorial-configuration.json",
  "status_box": {
    "position": "above_board_and_views",
